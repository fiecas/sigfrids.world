DATABASE_URL=postgres://user:password@localhost/sigfrids_world
# Accounts live here; /login and /signup redirect to it.
AUTH_URL=https://auth.fiecas.com
# Same value as AUTH_CLIENT_SECRET in the auth project.
AUTH_CLIENT_SECRET=generate-a-long-random-string
# This site's own origin; auth sends people back to PUBLIC_URL/auth/callback.
PUBLIC_URL=https://sigfrids.world
# Local development against a local auth (cd ../auth && cargo run):
# AUTH_URL=http://localhost:7879
# PUBLIC_URL=http://localhost:7878
